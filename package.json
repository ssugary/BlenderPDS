{
  "name": "collab3d",
  "private": true,
  "description": "Monorepo do BlenderPDS: framework collab3d (busy being extracted) e as aplicações que o usam.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "workspaces": [
    "apps/*/web",
    "framework/*"
  ],
  "scripts": {
    "build:core": "npm run build -w @collab3d/core",
    "test:core": "npm test -w @collab3d/core",
    "check-boundaries": "node scripts/check-boundaries.mjs",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "madge": "^8.0.0"
  }
}
