{
  "name": "@collab3d/core",
  "version": "0.2.0",
  "description": "Núcleo do framework collab3d: CRDT, sincronização, transporte, presença e render (sem React, sem domínio).",
  "type": "module",
  "main": "./dist/collab3d-core.js",
  "module": "./dist/collab3d-core.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/collab3d-core.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "three": ">=0.161.0"
  },
  "devDependencies": {
    "@types/three": "^0.161.2",
    "three": "^0.161.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.1.0"
  }
}
