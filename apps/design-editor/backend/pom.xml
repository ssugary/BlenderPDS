<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>dev.collab3d</groupId>
		<artifactId>collab3d-parent</artifactId>
		<version>0.1.0-SNAPSHOT</version>
		<relativePath>../../../pom.xml</relativePath>
	</parent>

	<groupId>com.grupo03</groupId>
	<artifactId>design-editor-backend</artifactId>
	<name>design-editor-backend</name>
	<description>Aplicação 1 do framework: o editor de design colaborativo (BlenderPDS)</description>

	<dependencies>
		<dependency>
			<groupId>dev.collab3d</groupId>
			<artifactId>collab3d-spring-boot-starter</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- Starts the Postgres/Mailpit from the repo-root compose.yaml on `spring-boot:run`.
		     The starter declares it as optional (a library must not force a container runtime on
		     its consumers), so the application opts in here. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-docker-compose</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
